{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/index",
      "destination": "/api/index?__subpath__=/"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__subpath__=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__subpath__=/$1"
    }
  ]
}
